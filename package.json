{
  "name": "@cc-heart/electron-use-ipc",
  "version": "0.0.1",
  "description": "Type-safe Electron IPC with hook-style APIs",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "import": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/main/index.ts src/preload/index.ts src/renderer/index.ts --format esm --dts --clean --external electron --target es2020 --sourcemap --no-splitting",
    "typecheck": "tsc --noEmit",
    "test:consumer": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck smoke/consumer.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:consumer"
  },
  "peerDependencies": {
    "electron": ">=20",
    "typescript": ">=5.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "electron",
    "ipc",
    "typescript",
    "typesafe",
    "hook",
    "signal"
  ]
}
